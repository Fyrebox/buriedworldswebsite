# Railway reference variable when the database service is named "Postgres":
# ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# A long private password for /admin/login.
ADMIN_PASSWORD=

# At least 32 unpredictable characters. Used only to sign admin sessions.
ADMIN_SESSION_SECRET=

# Optional comma-separated destination allowlist. Leave empty to permit any
# HTTPS destination, or keep this restricted list and add hosts as needed.
TRACKING_ALLOWED_HOSTS=www.meta.com,meta.com,store.steampowered.com,www.reddit.com,reddit.com,www.buriedworlds.com,buriedworlds.com

# Paid playtest. Set to "false" to close the public application form between
# waves; anything else (or unset) leaves it open.
PLAYTEST_OPEN=true

# Optional. At least 32 characters, used to sign the timestamp on the public
# application form so a script cannot post it without loading the page first.
# Falls back to ADMIN_SESSION_SECRET; blank on both disables that one check.
PLAYTEST_FORM_SECRET=

# Email a note to this address when a playtest application arrives. Needs
# SMTP_URL as well; with either unset, nothing is sent and the dashboard is
# the only place applications appear.
PLAYTEST_NOTIFY_TO=

# How the note goes out. Set ONE of the two:
#
# Amazon SES (preferred — an IAM key scoped to one sender, revocable on its
# own). MAIL_FROM must be a verified SES identity in that region; in the SES
# sandbox the recipient must be verified too, which for a note to yourself
# is the same address. The AWS SDK reads its keys from the standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY variables.
SES_REGION=
MAIL_FROM=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
#
# Or any SMTP server. For Google Workspace: 2-Step Verification on, then an
# App Password, then smtps://you%40yourdomain.com.au:APP_PASSWORD@smtp.gmail.com:465
# (the @ in the username is written %40). SMTP_FROM defaults to that user.
SMTP_URL=
SMTP_FROM=

# Delivery tracking for the study's email. SES reports each message's fate to
# the SNS topic; SNS pushes it to POST /api/ses-events on this site. Both must
# be set for events to flow; mail is sent either way.
SES_CONFIGURATION_SET=
SES_EVENTS_TOPIC_ARN=
