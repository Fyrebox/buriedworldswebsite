doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    //- Pages may override these; the landing page uses the defaults.
    title= pageTitle || 'Buried Worlds — A VR gold-prospecting adventure'
    meta(name="description" content=pageDescription || "Sweep, dig, pan, and travel the world's great gold rushes. Buried Worlds VR is coming soon to Meta Quest — and the daily deduction dig is playable now on Reddit.")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Inter:wght@400;500;600&display=swap")
    link(rel="stylesheet" href="/css/styles.css")
  body
    block content
