doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    //- Share cards and structured data both need ABSOLUTE urls — a relative
    //- path yields no preview at all, silently, which is the sort of thing you
    //- only discover after the link is already in somebody's inbox.
    - var canonical = siteUrl + (pagePath || '/')
    - var shareImage = siteUrl + (pageImage || '/images/og-cover.jpg')
    //- A page that supplies its own share image must supply its size and alt
    //- text with it — otherwise the cover's 1200×630 and Bolonia description
    //- would be claimed for a screenshot they do not describe.
    - var shareWidth = pageImage ? (pageImageWidth || '') : '1200'
    - var shareHeight = pageImage ? (pageImageHeight || '') : '630'
    - var shareAlt = pageImage ? (pageImageAlt || '') : "The game's logo above the Roman ruins at Bolonia, columns standing in pale sand."
    - var title = pageTitle || 'Buried Worlds VR — Out now on Meta Quest'
    - var description = pageDescription || "Sweep, dig, pan and travel five of the world's great treasure sites. Out now in Early Access on the Meta Horizon Store for Quest 2, 3, 3S and Pro."

    unless disableAnalytics
      //- Google tag (gtag.js) — GA4 property G-PVF7WKPPFD.
      //- The private admin area and redirect error pages opt out so the owner's
      //- own work never pollutes public campaign reporting.
      //-
      //- The 175 KB script is fetched once the page is idle, or on the first
      //- interaction, whichever comes first — not as a blocking part of the
      //- initial load. The stub below queues every gtag() call made in the
      //- meantime, so nothing is lost; the visit is reported a second or two
      //- later than it was.
      script.
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-PVF7WKPPFD');
        (function () {
          var loaded = false;
          function load() {
            if (loaded) return;
            loaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=G-PVF7WKPPFD';
            document.head.appendChild(s);
          }
          ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (type) {
            window.addEventListener(type, load, { once: true, passive: true });
          });
          if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 3000 });
          else setTimeout(load, 2000);
        })();

    //- Meta Pixel — so an ad that brought someone here can be told when they
    //- apply, and priced per application. Renders only with META_PIXEL_ID set.
    //- On by default wherever Analytics is; the study pages, which run no
    //- Analytics, opt in with metaPixel:true because the application is the
    //- conversion. Admin and error pages never carry it. It is never handed
    //- anything a visitor typed — PageView here, Lead on the confirmation page.
    - var showMetaPixel = metaPixelId && metaPixel !== false && (!disableAnalytics || metaPixel)
    if showMetaPixel
      script.
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '#{metaPixelId}');
        fbq('track', 'PageView');
      noscript
        img(height="1" width="1" style="display:none" alt="" src=`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`)

    //- Meta domain verification, so ads can attribute conversions on iOS and
    //- the pixel's events can be prioritised. The code comes from Business
    //- Settings → Domains; it is public by nature and renders on every page.
    if metaDomainVerification
      meta(name="facebook-domain-verification" content=metaDomainVerification)

    title= title
    meta(name="description" content=description)
    link(rel="canonical" href=canonical)
    if noIndex
      meta(name="robots" content="noindex,nofollow")

    //- Open Graph. Every launch link posted to Reddit, Discord, X or an email
    //- renders from these; without them the site shares as a bare grey url.
    meta(property="og:type" content="website")
    meta(property="og:site_name" content="Buried Worlds VR")
    meta(property="og:locale" content="en_AU")
    meta(property="og:title" content=title)
    meta(property="og:description" content=description)
    meta(property="og:url" content=canonical)
    meta(property="og:image" content=shareImage)
    if shareWidth
      meta(property="og:image:width" content=shareWidth)
    if shareHeight
      meta(property="og:image:height" content=shareHeight)
    if shareAlt
      meta(property="og:image:alt" content=shareAlt)

    meta(name="twitter:card" content="summary_large_image")
    meta(name="twitter:title" content=title)
    meta(name="twitter:description" content=description)
    meta(name="twitter:image" content=shareImage)

    meta(name="theme-color" content="#F6F2E6")
    link(rel="icon" href="/favicon.ico" sizes="any")
    link(rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png")
    link(rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png")
    link(rel="apple-touch-icon" href="/apple-touch-icon.png")

    //- Fonts are self-hosted (public/fonts, SIL OFL) — no third-party round
    //- trip before first paint. The two faces that render above the fold on
    //- every page are preloaded; the serif and italic load with the CSS.
    link(rel="preload" as="font" type="font/woff2" href="/fonts/oswald-latin.woff2" crossorigin="anonymous")
    link(rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin="anonymous")
    //- A page whose largest paint is a known image names it, so the browser
    //- fetches it before it has parsed as far as the element.
    if preloadImage
      link(rel="preload" as="image" href=preloadImage fetchpriority="high")
    //- The version is a hash of the stylesheet's bytes, set at startup, so the
    //- year-long cache on /css/* is busted by a CSS change and by nothing else.
    //- Templates rendered without it (tests) fall back to the bare path.
    link(rel="stylesheet" href=assetVersion ? `/css/styles.css?v=${assetVersion}` : '/css/styles.css')

    //- Escaping "<" keeps a stray closing tag in any future copy from ending
    //- the script element early. The payload is ours, but the cost is one call.
    if jsonLd
      script(type="application/ld+json")!= JSON.stringify(jsonLd).replace(/</g, '\\u003c')
  body(class=bodyClass)
    //- First focusable thing on every page. Off-screen until it is tabbed to,
    //- then it sits over the header and takes a keyboard user past it.
    a.skip(href="#content") Skip to content
    block content

    //- Outbound store clicks. The site cannot see installs, so views-into-store
    //- -clicks is the only conversion number it can report, and it is the one
    //- number the landing page can actually be changed to improve.
    //- GA4 sends via sendBeacon, which survives the navigation away.
    unless disableAnalytics
      script.
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[data-cta]');
          if (!a || typeof gtag !== 'function') return;
          gtag('event', 'store_click', {
            cta_location: a.getAttribute('data-cta'),
            link_url: a.href
          });
        });
