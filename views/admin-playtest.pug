extends layout

include partials/admin-nav

block content
  +adminNav()
  main#content.admin-shell
    .admin-heading
      div
        span.admin-kicker Private dashboard
        h1 Playtest applications
        p #{study.fee} for #{study.totalMinutes} minutes · #{study.places} places · terms #{study.termsVersion}
      .admin-heading__actions
        a.btn.btn--secondary(href="/admin/playtest/export.csv") Applications CSV
        a.btn.btn--secondary(href="/admin/playtest/submissions.csv") Submissions CSV

    if notice
      p.admin-alert.admin-alert--success(role="status")= notice

    unless applicationsOpen
      p.admin-alert(role="status") The public form is closed. Set PLAYTEST_OPEN=true to reopen it.

    .admin-metrics
      .admin-metric
        span.admin-metric__value= summary.total
        span.admin-metric__label Applications
      .admin-metric
        span.admin-metric__value= summary.byStatus.invited
        span.admin-metric__label Invited · waiting to accept
      .admin-metric
        span.admin-metric__value= summary.byStatus.joined
        span.admin-metric__label Joined · account confirmed
      .admin-metric
        span.admin-metric__value= summary.byStatus.paid
        span.admin-metric__label Paid

    .admin-panel(style="margin-bottom:30px")
      h2 Keys
      p(style="margin:0 0 14px;color:var(--ink-soft);font-size:13px")
        strong= keys.unused
        |  unused of #{keys.total} on file. Setting an application to Invited takes the next one and emails it to them; with none left, Invited is refused.
        if !mailConfigured
          |  #[strong Mail is not configured on this deployment], so no invitation would be sent — the key would only show on the application page.
      form(action="/admin/playtest/keys" method="post")
        input(type="hidden" name="_csrf" value=csrf)
        .admin-field.admin-field--wide
          span Paste keys from the Meta dashboard
          textarea.playtest-textarea(name="keys" rows="4" placeholder="One per line. Distribution → Keys → Generate, then copy them here." spellcheck="false")
          small Keys already on file are skipped, so pasting the same list twice does nothing.
        .admin-form__actions
          button.btn.btn--secondary(type="submit") Add keys

    .admin-panel(style="margin-bottom:30px")
      h2 Headsets applied
      p(style="margin:0;color:var(--ink-soft);font-size:13px")
        each headset, index in headsets
          span #{headset.label}: #{summary.byHeadset[headset.id]}
          if index < headsets.length - 1
            |  ·
        |  — hold Quest 2 places open longest; it is the weakest hardware and the likeliest source of comfort and performance findings.

    details.admin-panel(style="margin-bottom:30px")
      summary(style="cursor:pointer;font:600 1.25rem var(--font-display);text-transform:uppercase") The recruitment post
      p(style="margin:12px 0;color:var(--ink-soft);font-size:13px").
        Generated from the live terms, so it always matches the page. Text post under
        r/playtesters' Paid Playtest flair — recheck the rules the day you post. Swap the
        apply link for a /go/ campaign link to count arrivals.
      p(style="margin:0 0 6px;font:600 12px var(--font-display);letter-spacing:.06em;text-transform:uppercase;color:var(--bronze-link)") Title
      pre(style="white-space:pre-wrap;font:14px/1.5 var(--font-body);background:var(--paper);padding:12px 14px;border-radius:8px;margin:0 0 14px")= post.title
      p(style="margin:0 0 6px;font:600 12px var(--font-display);letter-spacing:.06em;text-transform:uppercase;color:var(--bronze-link)") Body (Markdown)
      pre(style="white-space:pre-wrap;font:14px/1.5 var(--font-body);background:var(--paper);padding:12px 14px;border-radius:8px;margin:0")= post.body

    if applications.length
      .admin-table-wrap
        table.admin-table
          thead
            tr
              th Applicant
              th Headset
              th Plays VR
              th Evidence
              th Status
              th Applied
              th
          tbody
            each application in applications
              tr
                td
                  a.admin-table__name(href=`/admin/playtest/${application.id}`)= application.reference
                  code= application.email
                  if application.playedBefore || application.ageGroup === 'minor' || application.emailTrouble
                    br
                  if application.emailTrouble
                    span.admin-alert(style="display:inline-block;padding:3px 8px;font-size:11px") Email bounced
                  if application.ageGroup === 'minor'
                    span.admin-status Under 18 · guardian
                  if application.playedBefore
                    span.admin-status Played before
                td= application.headsetLabel
                td= application.frequencyLabel
                td= application.captureMethod === 'recording' ? 'Recording' : 'Screenshots'
                td
                  if application.status === 'joined' || application.status === 'paid'
                    span.admin-status.admin-status--live= application.statusLabel
                  else
                    span.admin-status= application.statusLabel
                td= application.createdAt ? application.createdAt.slice(0, 10) : '—'
                td
                  a.admin-table__action(href=`/admin/playtest/${application.id}`) Open
    else
      .admin-empty
        h2 No applications yet
        p The form is live at /playtest. Point the recruitment post at a #[a(href="/admin/links") campaign link] so arrivals are counted without putting analytics on the study page.
