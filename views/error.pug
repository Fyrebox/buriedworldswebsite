extends layout

block content
  main.site-error
    a.site-error__brand(href="/" aria-label="Buried Worlds VR home") Buried Worlds VR

    .site-error__terrain(aria-hidden="true")
      span.site-error__marker

    section.site-error__card(aria-labelledby="error-title")
      span.site-error__code(aria-hidden="true")= statusCode
      if statusCode === 404
        span.site-error__kicker Trail gone cold
        h1#error-title Nothing buried here
        p.
          The page you were looking for has moved, vanished, or was never on
          this map in the first place.
        if requestedPath
          code.site-error__path= requestedPath
        .site-error__actions
          a.btn.btn--primary(href="/") Return to base camp
          a.btn.btn--secondary(href="/press") Open the press kit
      else
        span.site-error__kicker Signal interrupted
        h1#error-title The detector went quiet
        p.
          Something unexpected stopped this page from loading. The fault has
          been logged; trying again in a moment will often pick the trail back up.
        .site-error__actions
          a.btn.btn--primary(href=retryUrl) Try again
          a.btn.btn--secondary(href="/") Return to base camp

    p.site-error__help
      | Still stuck? #[a(href=links.discord target="_blank" rel="noopener noreferrer") Tell us on Discord].
