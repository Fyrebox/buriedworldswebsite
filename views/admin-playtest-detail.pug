extends layout

include partials/admin-nav

block content
  +adminNav()
  main#content.admin-shell.admin-shell--narrow
    a.admin-back(href="/admin/playtest") ← All applications
    .admin-heading.admin-heading--detail
      div
        span.admin-kicker Application
        h1= application.reference
        p Applied #{application.createdAt ? application.createdAt.slice(0, 10) : '—'} · terms #{application.termsVersion}

    if notice
      p.admin-alert.admin-alert--success(role="status")= notice
    if problem
      p.admin-alert(role="alert")= problem

    .admin-panel(style="margin-bottom:24px")
      h2 What they told us
      dl.playtest-terms
        .playtest-terms__row
          dt Email
          dd
            a(href=`mailto:${application.email}`)= application.email
        .playtest-terms__row
          dt Horizon username
          dd= application.horizonUsername
        .playtest-terms__row
          dt Headset
          dd= application.headsetLabel
        .playtest-terms__row
          dt Plays VR
          dd= application.frequencyLabel
        .playtest-terms__row
          dt Recent VR games
          dd= application.recentGames
        .playtest-terms__row
          dt Country
          dd= application.country
        .playtest-terms__row
          dt Evidence
          dd= application.captureLabel
        .playtest-terms__row
          dt Age
          dd
            = application.ageLabel
            if application.ageGroup === 'minor'
              |  — a parent or guardian agreed and receives the payment. Confirm with them by email before offering a place.
        .playtest-terms__row
          dt Played before
          dd= application.playedBefore ? 'Yes — consider for a later round' : 'No'
        if application.notes
          .playtest-terms__row
            dt Notes
            dd= application.notes

    .admin-panel(style="margin-bottom:24px")
      h2 Key
      if held
        p(style="margin:0;font-size:13px;color:var(--ink-soft)")
          | Sent #{held.assignedAt.slice(0, 10)}:
          |  #[code= held.key]
          |  — the Keys page in the Meta dashboard shows whether it has been redeemed.
      else
        p(style="margin:0;font-size:13px;color:var(--ink-soft)")
          | None yet. Setting Invited below assigns the next unused key (#{keys.unused} left) and emails it.

    .admin-panel(style="margin-bottom:24px")
      h2 Verification
      p(style="margin:0 0 14px;color:var(--ink-soft);font-size:13px").
        There is no way to look up a Meta account from an email address or a username,
        and probing Meta's sign-in to find out is account enumeration. The invitation is
        the check: send it from the developer dashboard, and this application is only
        confirmed once that address shows as Joined there.
      dl.playtest-terms
        .playtest-terms__row
          dt Invited
          dd= application.invitedAt ? application.invitedAt.slice(0, 10) : 'not yet'
        .playtest-terms__row
          dt Joined
          dd= application.joinedAt ? application.joinedAt.slice(0, 10) : 'not yet'
        .playtest-terms__row
          dt Paid
          dd= application.paidAt ? application.paidAt.slice(0, 10) : 'not yet'

    .admin-panel(style="margin-bottom:24px")
      h2 Submission
      if submission
        p(style="margin:0 0 14px;color:var(--ink-soft);font-size:13px").
          Submitted #{submission.submittedAt.slice(0, 10)}#{submission.submissionCount > 1 ? `, updated ${submission.updatedAt.slice(0, 10)} (${submission.submissionCount} versions)` : ''}.
          The #{study.paymentWindowHours}-hour payment window runs from the first submission.
        dl.playtest-terms
          .playtest-terms__row
            dt PayPal account
            dd
              code= submission.paypalAccount
              |  — pay #{study.fee} here, then set the status below to Paid.
          .playtest-terms__row
            dt Played on
            dd #{submission.headsetLabel}, about #{submission.minutesPlayed} minutes
          .playtest-terms__row
            dt Progress returned
            dd= submission.progressReturned === 'yes' ? 'Yes' : submission.progressReturned === 'no' ? 'No — something was missing or reset' : 'Not sure'
          .playtest-terms__row
            dt Marketplace screenshot
            dd
              a(href=submission.evidenceUrl target="_blank" rel="noopener noreferrer")= submission.evidenceUrl
              |  — check it shows at least #{study.minLoot} of finds before paying.
              if submission.evidenceNote
                br
                span= submission.evidenceNote
          if submission.clipUrl
            .playtest-terms__row
              dt Clip
              dd
                a(href=submission.clipUrl target="_blank" rel="noopener noreferrer")= submission.clipUrl
        h3(style="margin:22px 0 6px;font:600 13px var(--font-display);letter-spacing:.06em;text-transform:uppercase") Answers
        dl.playtest-terms
          each question in questionnaire.questions
            .playtest-terms__row
              dt= question.text
              dd(style="white-space:pre-wrap")= submission.answers[question.id] || '—'
      else
        p(style="margin:0;color:var(--ink-soft);font-size:13px").
          Nothing submitted yet. A tester submits on /playtest/questionnaire with their reference and email; the status moves to Submitted on its own when they do.

    form.admin-form(action=`/admin/playtest/${application.id}/status` method="post")
      input(type="hidden" name="_csrf" value=csrf)
      .admin-field.admin-field--wide
        span Status
        select.playtest-select(name="status")
          each status in statuses
            option(value=status.id selected=(status.id === application.status))= `${status.label} — ${status.hint}`
        small.
          Invited, Declined and Paid each email the applicant — the exact text is below.
          Dates above are stamped the first time a status is reached and never moved, so
          correcting a mistake cannot rewrite when an invitation actually went out.
      .admin-field.admin-field--wide(style="margin-top:22px")
        span Private note
        textarea.playtest-textarea(name="adminNote" rows="3" maxlength="2000")= application.adminNote
        small Only ever seen here. Screening reasoning, payment reference, correspondence.
      .admin-form__actions
        button.btn.btn--primary(type="submit") Save
        a.btn.btn--secondary(href="/admin/playtest") Back

    .admin-panel(style="margin-top:32px")
      h2 What they receive
      p(style="margin:0 0 14px;color:var(--ink-soft);font-size:13px")
        | Sent to #[code= application.email] when the status changes to each of these. Nothing else is ever sent.
        if !mailConfigured
          |  #[strong Mail is not configured on this deployment; nothing will be sent.]
      each name in ['invited', 'declined', 'paid']
        details(style="margin-bottom:10px")
          summary(style="cursor:pointer;font:600 13px var(--font-display);letter-spacing:.04em;text-transform:uppercase")= name
          pre(style="white-space:pre-wrap;font:13px/1.5 var(--font-body);background:var(--paper);padding:14px;border-radius:8px;margin:8px 0 0")
            strong Subject: #{previews[name].subject}
            | 
            | 
            = previews[name].text

    .admin-panel(style="margin-top:32px")
      h2 Delete
      p(style="margin:0 0 18px;color:var(--ink-soft);font-size:13px").
        Erases this application permanently. Use it when they ask, and when the
        retention window closes: unsuccessful applications 30 days after the study
        closes, everything else 90 days after final payment.
      form(action=`/admin/playtest/${application.id}/delete` method="post")
        input(type="hidden" name="_csrf" value=csrf)
        button.btn.btn--secondary(type="submit") Delete this application
