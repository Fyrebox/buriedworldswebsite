extends layout

include partials/playtest-strip
include partials/hero
include partials/trailer
include partials/buybar
include partials/vr
include partials/destinations
include partials/earlyaccess
include partials/reddit
include partials/discord
include partials/footer

block content
  //- Order changed at launch. The VR game is the thing being sold, so it now
  //- takes the whole run from the hero to the Early Access statement, and the
  //- free Reddit game sits after it as a companion rather than as the first
  //- ask. Before launch the Reddit band was the primary call to action, which
  //- is the right shape for a page with nothing to sell and the wrong one now.
  if playtestOpen
    +playtestStrip(study)
  +hero(heroVariant, links, product, trailer)
  //- One landmark for the whole run of sections, so a screen reader has a
  //- "main" to jump to and the skip link in the layout has somewhere to land.
  main#content
    +vr(loopSteps)
    +destinations(worlds, showLockedCard)
    +earlyaccess(links, product)
    +reddit(links, signalRows)
    +discord(links)
  +footer(links)
  +buybar(links, product)
  +trailerModal(trailer)
