//- Section 4 — Destinations gallery
//-
//- Each card is a link to its own page at /destinations/:slug. The whole card
//- is the anchor rather than just the name, so the hit area is the thing the
//- visitor is already looking at, and the hover outline the cards had before
//- now means what it looked like it meant.
mixin destinations(worlds, showLockedCard)
  section#destinations.destinations(data-screen-label="Destinations")
    .destinations__inner
      .section-head
        .ornament
          span.rule
          span.diamond
          span.rule
        h2.h2 Destinations
        p.serif-italic Five real places, five real rushes. Every field seeded by history.
      .dest-grid
        each w in worlds
          a.dest-card.dest-card--link(href=`/destinations/${w.slug}` aria-label=`${w.name} — read about this destination`)
            .dest-card__img(style=`background:${w.gradient}`)
              img.dest-card__photo(src=w.image alt=`${w.name} — terrain screenshot` loading="lazy" width="384" height="256")
            .dest-card__meta
              .dest-card__row
                span.dest-card__name= w.name
                span.dest-card__diamond
              span.dest-card__dash
              span.dest-card__sub= w.subtitle
        if showLockedCard
          //- 7th card — locked "more worlds coming" variant
          .dest-card.dest-card--locked
            .locked__img
              span.padlock
                span.padlock__shackle
                span.padlock__body
            .locked__meta
              span.locked__title More worlds coming
              span.locked__sub Kimberley, the Western Australian diamond country, is built and waiting. It is the first destination to arrive after launch.
              .locked__track
                .locked__fill
