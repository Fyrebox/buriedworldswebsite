//- Section 5 — Footer
include icons

mixin footer(links)
  footer.footer(data-screen-label="Footer")
    .footer__inner
      .footer__top
        .footer__brand
          span.footer__wordmark Buried Worlds VR
          p.footer__line News, new worlds and test invites go out on Discord first.
          a.footer__cta(href=links.discord target="_blank" rel="noopener noreferrer")
            +discordIcon()
            span Join the Discord
        .footer__links
          .footer__col
            span.footer__col-label Play
            a.footer__link(href=links.metaQuestStoreCta + '?placement=footer' target="_blank" rel="noopener noreferrer" data-cta="footer") Get it on Meta Quest
            a.footer__link(href="/how-to-play") How to play
            a.footer__link(href="/seated-vr") Seated play and comfort
            a.footer__link(href="/faq") FAQ
            a.footer__link(href="/#reddit") Today's dig on Reddit
          .footer__col
            span.footer__col-label Elsewhere
            a.footer__link(href="/about") About
            a.footer__link(href="/updates") Updates
            a.footer__link(href="/press") Press kit
            a.footer__link(href=links.subreddit) r/BuriedWorlds
            a.footer__link(href=links.discord target="_blank" rel="noopener noreferrer") Discord
      .footer__bottom
        span.footer__copy
          | © 2026 Buried Worlds VR. Real places, real hoards.
          span.footer__sep(aria-hidden="true")  · 
          a.footer__legal(href="/privacy") Privacy
          span.footer__sep(aria-hidden="true")  · 
          a.footer__legal(href="/terms") Terms
          span.footer__sep(aria-hidden="true")  · 
          a.footer__legal(href="/admin" rel="nofollow") Admin
        .ornament.ornament--footer
          span.rule
          span.diamond
          span.rule
