//- Section 5 — Footer
include icons

mixin footer(links)
  footer.footer(data-screen-label="Footer")
    .footer__inner
      .footer__top
        .footer__brand
          span.footer__wordmark Buried Worlds
          p.footer__line News, new worlds and test invites go out on Discord first.
          a.footer__cta(href=links.discord target="_blank" rel="noopener noreferrer")
            +discordIcon()
            span Join the Discord
        .footer__links
          .footer__col
            span.footer__col-label Play
            a.footer__link(href=links.metaQuestStore target="_blank" rel="noopener noreferrer" data-cta="footer") Get it on Meta Quest
            a.footer__link(href="#vr") How it plays
            a.footer__link(href="#reddit") Today's dig on Reddit
          .footer__col
            span.footer__col-label Elsewhere
            a.footer__link(href="/press") Press kit
            a.footer__link(href=links.subreddit) r/BuriedWorlds
            a.footer__link(href=links.discord target="_blank" rel="noopener noreferrer") Discord
      .footer__bottom
        span.footer__copy
          | © 2026 Buried Worlds. Real places, real hoards.
          |  ·
          a.footer__legal(href="/privacy") Privacy
          |  ·
          a.footer__legal(href="/terms") Terms
        .ornament.ornament--footer
          span.rule
          span.diamond
          span.rule
