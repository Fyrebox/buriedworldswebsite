mixin adminNav()
  header.admin-nav
    a.admin-nav__brand(href="/admin") Buried Worlds · Admin
    nav.admin-nav__actions(aria-label="Admin")
      a(href="/admin") Home
      a(href="/admin/links") Links
      a(href="/admin/playtest") Playtest
      a(href="/admin/playtest/emails") Emails
      form(action="/admin/logout" method="post")
        input(type="hidden" name="_csrf" value=csrf)
        button.admin-nav__logout(type="submit") Sign out
