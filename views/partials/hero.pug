//- Hero — three variants. "poster" is the shipped default (README §1).
include icons

mixin hero(variant, links, product, trailer)
  if variant === 'split'
    +heroSplit(links, product)
  else if variant === 'banner'
    +heroBanner(links, product)
  else
    +heroPoster(links, product, trailer)

//- Poster variant (default)
mixin heroPoster(links, product, trailer)
  header.hero(data-screen-label="Hero — poster")
    .hero__inner
      h1.h1 Buried Worlds VR
      p.hero__tagline Sweep, dig, pan, and travel the world's great gold rushes. A gold-prospecting adventure in virtual reality.
      span.badge.badge--live Out now · Early Access
      //- CTAs sit above the key art so they stay above the fold on short screens.
      .hero__cta
        a.btn.btn--primary(href=links.metaQuestStore target="_blank" rel="noopener noreferrer" data-cta="hero") Get it on Meta Quest
        a.btn.btn--secondary(href="#vr") See how it plays
        a.btn.btn--secondary.btn--icon(href=links.discord target="_blank" rel="noopener noreferrer")
          +discordIcon()
          span Join the Discord
      //- The price carries its currency because Meta localises the real figure.
      p.hero__meta
        | #{product.price} on the #{product.store}
        span.hero__meta-dot ·
        | #{product.devices}
      //- The painted key art is the poster, so it is on screen instantly and
      //- the video fades in over it rather than the slot sitting empty. The
      //- clip is decorative — muted, looping, no controls — so it is hidden
      //- from assistive technology and the play button carries the meaning.
      .keyart
        video.keyart__video(
          poster=trailer.poster
          autoplay muted loop playsinline disablepictureinpicture
          preload="metadata"
          aria-hidden="true"
          tabindex="-1"
        )
          source(src=trailer.loop type="video/mp4")
        button.keyart__play(type="button" data-trailer-open)
          span.keyart__play-icon(aria-hidden="true")
          span Watch the trailer · #{trailer.duration}

//- Split variant (reference)
mixin heroSplit(links, product)
  header.hero-split(data-screen-label="Hero — split")
    .hero-split__grid
      .hero-split__copy
        .ornament
          span.rule(style="width:44px")
          span.diamond
          span.hero-split__kicker An expedition in six worlds
        h1.h1 Buried
          br
          | Worlds VR
        p.serif(style="margin:0;font-size:1.35rem;color:var(--ink-soft);line-height:1.45") Sweep, dig, pan, and travel the world's great gold rushes — from the creeks of Ballarat to a Suffolk field that hid a Roman hoard for sixteen centuries.
        span.badge.badge--live(style="padding:6px 16px;font-size:12.5px") Out now · Early Access
        .hero__cta(style="justify-content:flex-start;margin-top:0")
          a.btn.btn--primary(href=links.metaQuestStore target="_blank" rel="noopener noreferrer" data-cta="hero-split") Get it on Meta Quest
          a.btn.btn--secondary(href="#vr") See how it plays
      .hero-split__art
        span.img-note VR key art — portrait

//- Banner variant (reference)
mixin heroBanner(links, product)
  header.hero-banner(data-screen-label="Hero — banner")
    span.img-note.hero-banner__note VR key art — full-bleed
    .hero-banner__scrim
    .hero-banner__inner
      h1.h1 Buried Worlds VR
      p.hero-banner__tagline Sweep, dig, pan, and travel the world's great gold rushes.
      .hero__cta(style="justify-content:flex-start;margin-top:0;align-items:center")
        a.btn.btn--gold.btn--gold-banner(href=links.metaQuestStore target="_blank" rel="noopener noreferrer" data-cta="hero-banner") Get it on Meta Quest
        span.badge.badge--live.badge--live-light Out now · Early Access
