//- Hero — three variants. "poster" is the shipped default (README §1).
mixin hero(variant, links)
  if variant === 'split'
    +heroSplit(links)
  else if variant === 'banner'
    +heroBanner(links)
  else
    +heroPoster(links)

//- Poster variant (default)
mixin heroPoster(links)
  header.hero(data-screen-label="Hero — poster")
    .hero__inner
      .ornament.ornament--hero
        span.rule
        span.diamond
        span.rule
      h1.h1 Buried Worlds
      p.hero__tagline Sweep, dig, pan, and travel the world's great gold rushes. A gold-prospecting adventure in virtual reality.
      span.badge.badge--coming Coming soon to Meta Quest
      .keyart
        span.img-note VR key art — hero shot
      .hero__cta
        a.btn.btn--primary(href="#reddit") Play today's dig on Reddit
        a.btn.btn--secondary(href="#vr") About the VR game

//- Split variant (reference)
mixin heroSplit(links)
  header.hero-split(data-screen-label="Hero — split")
    .hero-split__grid
      .hero-split__copy
        .ornament
          span.rule(style="width:44px")
          span.diamond
          span.hero-split__kicker An expedition in six worlds
        h1.h1 Buried
          br
          | Worlds
        p.serif(style="margin:0;font-size:1.35rem;color:var(--ink-soft);line-height:1.45") Sweep, dig, pan, and travel the world's great gold rushes — from the creeks of Castlemaine to a Suffolk field that hid a Roman hoard for sixteen centuries.
        span.badge.badge--coming(style="padding:6px 16px;font-size:12.5px") Coming soon to Meta Quest
        .hero__cta(style="justify-content:flex-start;margin-top:0")
          a.btn.btn--primary(href="#reddit") Play today's dig on Reddit
          a.btn.btn--secondary(href="#vr") About the VR game
      .hero-split__art
        span.img-note VR key art — portrait

//- Banner variant (reference)
mixin heroBanner(links)
  header.hero-banner(data-screen-label="Hero — banner")
    span.img-note.hero-banner__note VR key art — full-bleed
    .hero-banner__scrim
    .hero-banner__inner
      h1.h1 Buried Worlds
      p.hero-banner__tagline Sweep, dig, pan, and travel the world's great gold rushes.
      .hero__cta(style="justify-content:flex-start;margin-top:0;align-items:center")
        a.btn.btn--gold.btn--gold-banner(href="#reddit") Play today's dig on Reddit
        span.badge.badge--coming.badge--coming-light Coming soon to Meta Quest
